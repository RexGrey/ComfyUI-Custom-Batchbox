# =============================================================================
# 🔐 供应商配置模板 (包含 API 密钥 - 请勿上传到 GitHub!)
# =============================================================================
# 请复制此文件并重命名为 secrets.yaml，然后填入您的 API 密钥
# secrets.yaml 会被 .gitignore 忽略，不会上传到版本控制
# =============================================================================

providers:
  # 示例供应商 1
  example_provider:
    display_name: Example Provider
    base_url: https://api.example.com
    rate_limit: 100
    api_key: sk-your-api-key-here

  # 示例供应商 2
  another_provider:
    display_name: Another Provider
    base_url: https://api.another.com
    rate_limit: 60
    api_key: ""

  # acggit.com Account 代理服务（Token 由登录流程自动获取）
  acggit_account:
    display_name: Account 服务 (稳定通道)
    base_url: https://api-addon.acggit.com/v1
    rate_limit: 100
    api_key: ""  # Account 模式不需要 API Key

  # Google 官方 Gemini API（需要自己的 API Key）
  google_official:
    display_name: Google 官方 API
    base_url: https://generativelanguage.googleapis.com/v1beta
    rate_limit: 60
    api_key: ""  # 填入你的 Google API Key

  # APIMart 官方 GPT-Image-2 通道（需要自己的 APIMart API Key）
  apimart:
    display_name: APIMart 官方
    base_url: https://api.apimart.ai
    rate_limit: 60
    api_key: ""  # 填入你的 APIMart API Key

# =============================================================================
# 🔑 Account 服务配置 (acggit.com 代理)
# =============================================================================
# 通过 Account 模式使用 AIGODLIKE 提供的稳定 API 代理服务
# Token 由 ComfyUI 前端登录流程自动获取和存储
# =============================================================================
account:
  auth_mode: account     # api | account
  # 以下为高级配置，通常不需要修改
  # api_base_url: https://api-addon.acggit.com
  # login_url: https://addon-login.acggit.com
  # pricing_strategy: bestPrice  # bestPrice | bestBalance

# =============================================================================
# ☁️ Google Cloud Storage 缓存 (Gemini img2img 带宽优化)
# =============================================================================
# 将参考图上传到 GCS，通过 gs:// URI 引用，避免 base64 内嵌
# 需要: pip install google-cloud-storage
# =============================================================================
# gcs:
#   bucket_name: your-bucket-name
#   credentials_path: gcs-service-account.json  # 相对于插件目录
#   path_prefix: images

# =============================================================================
# ☁️ 阿里云 OSS 缓存 (柏拉图等 OpenAI 兼容端点)
# =============================================================================
# oss:
#   access_key_id: your-access-key-id
#   access_key_secret: your-access-key-secret
#   bucket_name: your-bucket-name
#   endpoint: oss-accelerate.aliyuncs.com
#   public_endpoint: oss-cn-hangzhou.aliyuncs.com
