# Service Account JSON keys (Google Cloud)
service_accounts/
*.service_account.json

# Gateway client credentials
gateway_client.json

# GCS 凭据
gcs_credentials*.json

# 运行时缓存数据库
*.db
*.db-shm
*.db-wal

# 环境变量文件
.env
.env.*

# 私钥文件
*.pem
*.p12
*.key
*.pfx

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo

# 本地测试与日志文件
_bench_results.json

# Superpowers 技能隔离目录
.worktrees/
worktrees/

# Cython & Build Artifacts
build/
dist/
*.pyd
*.exp
*.lib
*.obj
*.c

# Playwright / browser debug profiles
output/

# Pytest cache
.pytest_cache/
