__pycache__/
*.pyc
.DS_Store

# ===== 敏感文件 - 绝对不能上传 =====

# API 密钥配置
secrets.yaml
.secrets_key

# Account 登录凭据 (token, email)
.auth.json

# Service Account JSON keys (Google Cloud)
service_accounts/
*.service_account.json

# Gateway client credentials
gateway_client.json

# GCS 凭据
gcs_credentials*.json

# 运行时缓存数据库
*.db
*.db-shm
*.db-wal

# 环境变量文件
.env
.env.*

# 私钥文件
*.pem
*.p12
*.key
*.pfx

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo

# 本地测试与日志文件
_bench_results.json
